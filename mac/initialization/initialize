#!/bin/zsh

# Main initialization script that calls all sub-scripts

SCRIPT_DIR="$(dirname "$(realpath "$0")")"

# sudo 待ちで気づけるようベルを仕込む（子プロセス=公式インストーラや cask にも継承される）
source "${SCRIPT_DIR}/../scripts/common.sh"

parse_settingfiles_common_args "mac/initialize" "$@"
_args_status=$?
if (( _args_status == 10 )); then
    exit 0
elif (( _args_status != 0 )); then
    exit "$_args_status"
fi
unset _args_status

enable_sudo_bell

echo "Starting macOS initialization..."

# Execute all initialization scripts in order

echo "\n[1/9] Copying configuration files..."
source "${SCRIPT_DIR}/copy_files.sh"

echo "\n[2/9] Installing Homebrew and packages..."
source "${SCRIPT_DIR}/homebrew.sh"

echo "\n[3/9] Setting up development tools..."
source "${SCRIPT_DIR}/dev_tools.sh"

echo "\n[4/9] Setting up tmux..."
source "${SCRIPT_DIR}/tmux.sh"

echo "\n[5/9] Setting up notify icons..."
source "${SCRIPT_DIR}/notify_icons.sh"

echo "\n[6/9] Setting up Git configuration..."
source "${SCRIPT_DIR}/git_setup.sh"

echo "\n[7/9] System setup..."
source "${SCRIPT_DIR}/system_setup.sh"

echo "\n[8/9] Setting up AI assistants..."
source "${SCRIPT_DIR}/ai/claude.sh"
source "${SCRIPT_DIR}/ai/gemini.sh"
source "${SCRIPT_DIR}/ai/other.sh"
source "${SCRIPT_DIR}/ai/codex.sh"

echo "\n[9/9] Setting up Herdr..."
source "${SCRIPT_DIR}/herdr.sh"

echo "\nmacOS initialization completed!"

cat "${SCRIPT_DIR}/NOTES.md"
